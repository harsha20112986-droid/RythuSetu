# =================================================================
# RythuSetu Production & Development Environment Configuration
# =================================================================

# Backend Core Configuration
APP_NAME="RythuSetu API"
APP_ENV=development
API_V1_PREFIX=/api/v1

# Database Connection URL
# In development: defaults to SQLite (sqlite:///rythusetu.db) if left blank
# In production (PostgreSQL / Render / Supabase):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rythusetu

# JWT Authentication & Cryptographic Security
# Generate a secure 32+ byte key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_random_32_byte_hex_string_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Agriculture Officer / Admin Bootstrap Password
# Change this immediately upon deployment
ADMIN_INITIAL_PASSWORD=SetAStrongRandomPassword2026!

# Strict CORS Allowed Origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rythu-setu.vercel.app

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Optional External AI Services (Fallback rules & heuristics run offline if unconfigured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
WEATHER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Mandi Data Ingestion Pipeline (Government Open Data)
# ─────────────────────────────────────────────────────────────────────────────
# Register at: https://data.gov.in/  →  My Account → API Keys
# Without this key the pipeline runs in OFFLINE_UNCONFIGURED mode and returns
# seeded baseline APMC records. Live daily ingestion is disabled.
DATA_GOV_API_KEY=

# Optional: Agmarknet direct API credential (if separately provisioned)
# Leave blank to rely on data.gov.in endpoint above.
AGMARKNET_API_KEY=

# States to sync in nightly cron (cron_sync.py / Render Cron Service)
MANDI_SYNC_STATES="Telangana,Andhra Pradesh"

# Max records fetched per state per ingestion run
MANDI_SYNC_LIMIT=1000

# Nightly cron schedule — Render Cron is set to: "30 19 * * *" (01:00 IST)
# This env var is for local reference only; the actual schedule is in render.yaml
MANDI_INGESTION_CRON="30 19 * * *"
